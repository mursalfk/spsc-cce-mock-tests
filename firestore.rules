// firestore.rules
// Paste into Firebase console > Firestore Database > Rules > Publish.
// Each signed-in user (email verified) can read and write only their own records.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function mine(uid) {
      return verified() && request.auth.uid == uid;
    }
    function validAttempt(d) {
      return d.keys().hasOnly(['v','test','title','mode','ts','net','c','w','u','used','sec','emailed'])
        && d.keys().hasAll(['v','test','title','mode','ts','net','c','w','u','used','sec','emailed'])
        && d.v == 1
        && d.test is int && d.test >= 1 && d.test <= 99
        && d.title is string && d.title.size() <= 60
        && d.mode == 'exam'
        && d.ts is number
        && d.c is int && d.w is int && d.u is int
        && d.c >= 0 && d.w >= 0 && d.u >= 0 && d.c + d.w + d.u <= 200
        && d.net is number && d.net == d.c - 0.25 * d.w
        && d.used is number && d.used >= 0 && d.used <= 20000
        && d.sec is map
        && d.emailed is bool;
    }

    match /users/{uid} {
      allow read: if mine(uid);
      allow create, update: if mine(uid)
        && request.resource.data.keys().hasOnly(['name','email','updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;

      match /attempts/{aid} {
        allow read: if mine(uid);
        allow create: if mine(uid) && validAttempt(request.resource.data);
        // an existing result can only flip the "emailed" flag
        allow update: if mine(uid) && validAttempt(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailed']);
        allow delete: if false;
      }
    }
  }
}
